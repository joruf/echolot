[Desktop Entry]
Version=1.0
Type=Application
Name=Echolot
Comment=Record conversations from the system tray
Comment[de]=Gesprächsmitschnitt aus der System-Tray
Comment[es]=Graba conversaciones desde el área de notificación
Comment[fr]=Enregistre les conversations depuis la zone de notification
# %k is the path of this file, so the program beside it is the one that starts -- wherever the
# folder was copied to. The same path repairs Icon= in place: a .desktop file cannot point at its
# icon with a relative path (the spec reads one as a theme name), so the launcher writes the
# absolute path of the icon next to it whenever the folder has moved.
Exec=/bin/bash -c "s=\\$(readlink -f \\"\\$0\\"); d=\\${s%%/*}; i=\\$d/resources/echolot-idle.svg; grep -qxF \\"Icon=\\$i\\" \\"\\$s\\" || { I=\\$i awk '/^Icon=/{print \\"Icon=\\" ENVIRON[\\"I\\"]; next}1' \\"\\$s\\" > \\"\\$s.new\\" && mv -f \\"\\$s.new\\" \\"\\$s\\"; }; cd \\"\\$d\\" && exec python3 ./run.py" %k
Icon=/home/joruf/Applications/echolot/resources/echolot-idle.svg
Terminal=false
StartupNotify=false
StartupWMClass=echolot
Categories=AudioVideo;Audio;Recorder;
Keywords=recording;conversation;recorder;Aufnahme;Mitschnitt;Gespräch;
